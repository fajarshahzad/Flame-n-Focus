GEMINI_API_KEY=your_key_here
# Gemma 4 ids on the Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# No API key? Run Gemma 4 locally with Ollama instead: pull a Gemma 4 model, then set its tag here
# OLLAMA_MODEL=
# OLLAMA_URL=http://localhost:11434

# Gemma 4 "thinking": minimal is fast (~1s). Set to empty to use the model default (slow).
# GEMMA_THINKING=minimal
